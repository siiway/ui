{
  "name": "@siiway/ui-react",
  "version": "0.1.0",
  "description": "SiiWay's Fluent UI v9 theme, provider and components for React.",
  "license": "MIT",
  "homepage": "https://ui.siiway.org",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siiway/ui.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@siiway/ui-core": "workspace:*"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.73.0",
    "@fluentui/react-icons": "^2.0.300",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.345",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
