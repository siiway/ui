{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
