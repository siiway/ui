{
  "name": "siiway-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun scripts/hooks.ts",
    "build": "tsc -b packages/core packages/react",
    "typecheck": "bun run build && tsc -p tsconfig.test.json && tsc -p docs",
    "storybook": "storybook dev -p 6006 --docs",
    "build-storybook": "storybook build -o storybook-static --docs --quiet",
    "llms": "storybook-llms-extractor --distPath storybook-static --summaryBaseUrl https://ui.siiway.org --summaryTitle \"SiiWay UI\" --summaryDescription \"The look of SiiWay's apps: design tokens, a Fluent UI theme and React components.\"",
    "lint": "bun --bun eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run build && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "clean": "bun scripts/clean.ts",
    "changeset": "changeset",
    "version": "changeset version && bun install && prettier --write \"packages/*/CHANGELOG.md\"",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.345",
    "@fluentui/storybook-llms-extractor": "0.0.4",
    "@j178/prek": "0.5.9",
    "@siiway/ui-core": "workspace:*",
    "@siiway/ui-react": "workspace:*",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4",
    "storybook": "^10.6.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
