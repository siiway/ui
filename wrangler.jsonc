{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siiway-ui",
  "compatibility_date": "2026-11-01",
  // A static site: the built Storybook (`bun run build-storybook`), no Worker
  // code. Deployed by .github/workflows/storybook.yml.
  "assets": { "directory": "./storybook-static" },
  "routes": [{ "pattern": "ui.siiway.org", "custom_domain": true }],
  "workers_dev": false,
  "env": {
    // main before it's released, as the Worker siiway-ui-preview.
    "preview": {
      "routes": [{ "pattern": "preview.ui.siiway.org", "custom_domain": true }],
    },
  },
}
