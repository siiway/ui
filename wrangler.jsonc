{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siiway-ui",
  "compatibility_date": "2026-11-01",
  // A static site: the built Storybook (`bun run build-storybook`), no Worker
  // code. Deployed by .github/workflows/storybook.yml.
  "assets": { "directory": "./storybook-static" },
  "routes": [{ "pattern": "ui.siiway.org", "custom_domain": true }],
  "workers_dev": false,
  // Versions uploaded from main (not deployed) are served at their preview
  // URLs on workers.dev. A deploy applies this setting.
  "preview_urls": true,
}
