{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siiway-ui",
  "compatibility_date": "2026-11-01",
  // A static site: the built Storybook (`bun run build-storybook`), no Worker
  // code. Deployed by .github/workflows/storybook.yml.
  "assets": { "directory": "./storybook-static" },
  // The site, and its Previews (`wrangler preview --name <name>`) at
  // <name>.ui.siiway.org.
  "routes": [{ "pattern": "ui.siiway.org", "custom_domain": true, "previews_enabled": true }],
  "workers_dev": false,
  // Previews take nothing from production; a static site has nothing to set.
  "previews": {},
}
