{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siiway-ui",
  "compatibility_date": "2026-11-01",
  // A static site: the built Storybook (`bun run build-storybook`), no Worker
  // code. Deployed by .github/workflows/storybook.yml.
  "assets": { "directory": "./storybook-static" },
  // As in the dashboard, which a deploy makes match: the site, and a domain
  // for Previews only, where `wrangler preview --name <name>` is served at
  // <name>.preview.ui.siiway.org.
  "routes": [
    { "pattern": "ui.siiway.org", "custom_domain": true },
    {
      "pattern": "preview.ui.siiway.org",
      "custom_domain": true,
      "enabled": false,
      "previews_enabled": true,
    },
  ],
  "workers_dev": false,
  // Previews take nothing from production; a static site has nothing to set.
  "previews": {},
}
